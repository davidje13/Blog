{
	"$schema": "../node_modules/web-listener/schema.json",
	"servers": [
		{
			"port": 8080,
			"mount": [
				{
					"type": "headers",
					"headers": {
						"cache-control": "public, max-age=600, stale-while-revalidate=31536000, stale-if-error=31536000",
						"content-security-policy": "base-uri 'self'; default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; frame-ancestors 'self'; form-action 'none'",
						"cross-origin-opener-policy": "same-origin",
						"cross-origin-embedder-policy": "require-corp",
						"x-content-type-options": "nosniff",
						"referrer-policy": "no-referrer"
					}
				},
				{
					"type": "files",
					"path": "/",
					"dir": "./static",
					"options": {
						"negotiation": [
							{
								"feature": "encoding",
								"options": [{ "value": "gzip", "file": "{file}.gz" }]
							}
						]
					}
				}
			]
		}
	],
	"mime": { "rss": "application/rss+xml" }
}
